# Copy this file's variable names into Vercel → Project → Settings →
# Environment Variables. Never commit a real .env file with actual secrets
# to git — this .env.example is safe to commit because it has no real values.
#
# Named to match how you set up your other project's environment variables.

# Stripe — Dashboard → Developers → API keys. Use the sk_test_... key while
# testing, switch to the sk_live_... key when ready to accept real payments.
STRIPE_SECRET_KEY=

# Stripe — Dashboard → Developers → Webhooks → Add endpoint
#   URL: https://<your-domain>/api/stripe-webhook
#   Event: checkout.session.completed
# Stripe shows you a signing secret (starts "whsec_") after creating it —
# paste that here.
STRIPE_WEBHOOK_SECRET=

# Resend — Dashboard → API Keys → Create API Key
RESEND_API_KEY=

# Resend — Dashboard → Audiences → open your existing audience → copy the
# ID from the URL (resend.com/audiences/<this-part>).
RESEND_AUDIENCE_ID=

# Your live site's base URL, no trailing slash. Used to build the Stripe
# checkout success/cancel redirect links.
SITE_URL=https://korzavo.com

# The address all outgoing emails (order confirmations, order notifications,
# newsletter welcome/notification emails) are sent FROM. Must be on a
# domain verified in Resend (Resend → Domains). Format:
#   Display Name <address@yourdomain.com>
# Leave unset while testing — it falls back to Resend's own test sender
# (onboarding@resend.dev), which works immediately with no domain setup.
ORDER_NOTIFICATION_FROM=Korzavo <orders@korzavo.com>

# The address that receives order notifications and new-subscriber alerts.
# Defaults to support@korzavo.com if left unset.
ORDER_NOTIFICATION_EMAIL=support@korzavo.com
